---
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import { TIPOS } from '../../config';
import Voy from '../../components/Voy.astro';
import { rangoFechas, ciudadCorta, modalidadTexto, plazoInfo, etiquetas, type Evento } from '../../lib/formato';
import { EVENTOS, ARCHIVO, anualDe } from '../../lib/anuales';

// Fichas de los próximos y de los que ya pasaron (el archivo), para no romper enlaces.
export function getStaticPaths() {
  const vistos = new Set(EVENTOS.map((e) => e.slug));
  return [
    ...EVENTOS.map((e) => ({ params: { slug: e.slug }, props: { evento: e, pasado: false } })),
    ...ARCHIVO.filter((e) => !vistos.has(e.slug)).map((e) => ({ params: { slug: e.slug }, props: { evento: e, pasado: true } })),
  ];
}

const { evento: e, pasado } = Astro.props as { evento: Evento; pasado: boolean };
const plazo = plazoInfo(e);
const chips = etiquetas(e);
const anual = anualDe(e);
const tipo = TIPOS[e.tipo] || TIPOS.otro;
const cuando = rangoFechas(e.inicio, e.fin);
const donde = e.modalidad === 'online' ? 'Online' : (e.direccion || e.ciudad || 'Lugar por confirmar');

// «Añadir al calendario»: enlace de Google Calendar (todo el día) y fichero .ics generado aparte.
const sinGuiones = (s: string | null) => (s || '').replace(/-/g, '');
const finMasUno = e.fin || e.inicio ? new Date(`${e.fin || e.inicio}T00:00:00Z`) : null;
finMasUno?.setUTCDate(finMasUno.getUTCDate() + 1);
const google = e.inicio
  ? `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(e.nombre)}&dates=${sinGuiones(e.inicio)}/${sinGuiones(finMasUno!.toISOString().slice(0, 10))}&details=${encodeURIComponent(e.url || '')}&location=${encodeURIComponent(donde)}`
  : null;

const ld = {
  '@context': 'https://schema.org', '@type': 'Event', name: e.nombre,
  startDate: e.inicio, endDate: e.fin || e.inicio,
  eventAttendanceMode: e.modalidad === 'online' ? 'https://schema.org/OnlineEventAttendanceMode'
    : e.modalidad === 'hibrido' ? 'https://schema.org/MixedEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  location: e.modalidad === 'online' ? { '@type': 'VirtualLocation', url: e.url } : { '@type': 'Place', name: donde, address: donde },
  image: e.imagen ? [e.imagen] : undefined, url: e.url,
  organizer: e.organizador ? { '@type': 'Organization', name: e.organizador } : undefined,
};
---
<Base titulo={`${e.nombre} · ${tipo.nombre} · Todothon`} descripcion={`${tipo.nombre} ${e.modalidad === 'online' ? 'online' : `en ${ciudadCorta(e)}`}, ${cuando}. Toda la información y el enlace a la web oficial.`} imagen={e.imagen}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="envoltorio ficha">
    <a class="volver" href="/#resultados">← Todos los eventos</a>
    {pasado && (
      <p class="ficha__pasado">
        <strong>Este evento ya pasó.</strong>{' '}
        {anual
          ? <>Se celebra cada año: mira <a href={`/cada-ano/${anual.clave}`}>cuándo es la próxima edición de {anual.nombre}</a>.</>
          : <>Mira los <a href="/#resultados">próximos eventos</a>.</>}
      </p>
    )}
    <div class="ficha__rejilla">
      <div class="ficha__cartel">
        <Cartel evento={e} grande />
      </div>
      <div class="ficha__datos">
        <span class="ficha__tipo" style={`background: ${tipo.color}`}>{tipo.nombre}</span>
        <h1>{e.nombre}</h1>
        {!pasado && plazo && <p class:list={['ficha__plazo', { urgente: plazo.urgente, cerrado: plazo.cerrado }]}>{plazo.texto}</p>}
        {chips.length > 0 && <ul class="ficha__chips">{chips.map((c) => <li>{c}</li>)}</ul>}
        <dl>
          <div><dt>Cuándo</dt><dd>{cuando}</dd></div>
          <div><dt>Dónde</dt><dd>{donde}</dd></div>
          <div><dt>Formato</dt><dd>{modalidadTexto(e.modalidad)}</dd></div>
          {e.organizador && <div><dt>Organiza</dt><dd>{e.organizador}</dd></div>}
          {e.premio && <div><dt>Premios</dt><dd>{e.premio}</dd></div>}
          {e.gratis !== null && <div><dt>Precio</dt><dd>{e.gratis ? 'Gratis' : 'De pago'}</dd></div>}
          {e.requisitos?.length > 0 && <div><dt>Para quién</dt><dd>{e.requisitos.join(' · ')}</dd></div>}
          {e.temas?.length > 0 && <div><dt>Temas</dt><dd>{e.temas.join(' · ')}</dd></div>}
        </dl>
        {!pasado && <Voy slug={e.slug} />}
        {!pasado && anual && <p class="ficha__anual">📅 {anual.nombre} se celebra cada año. <a href={`/cada-ano/${anual.clave}`}>Ver ediciones anteriores</a></p>}
        <div class="ficha__acciones">
          {e.url && <a class="boton boton--rosa" href={e.url} rel="noopener">Ir a la web oficial ↗</a>}
          {!pasado && google && <a class="boton" href={google} rel="noopener">Añadir a Google Calendar</a>}
          {!pasado && <a class="boton" href={`/evento/${e.slug}.ics`}>Descargar .ics</a>}
        </div>
        {e.descripcion && <p class="ficha__desc">{e.descripcion}</p>}
        <p class="ficha__fuente">Dato sacado de {e.fuente}{e.urlFuente && <> (<a href={e.urlFuente} rel="noopener">ver origen</a>)</>}. Comprueba siempre la información en la web oficial. ¿Algo mal? <a href="/publicar">Avísanos</a>.</p>
      </div>
    </div>
    {e.lat != null && e.lon != null && (
      <div class="ficha__mapa">
        <iframe
          title={`Mapa de ${donde}`}
          loading="lazy"
          src={`https://www.openstreetmap.org/export/embed.html?bbox=${e.lon - 0.01},${e.lat - 0.006},${e.lon + 0.01},${e.lat + 0.006}&layer=mapnik&marker=${e.lat},${e.lon}`}
        ></iframe>
      </div>
    )}
  </article>
</Base>

<style>
  .ficha { padding-top: 16px; }
  .volver { display: inline-block; padding: 10px 0; font-weight: 700; }
  .ficha__rejilla { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; margin-top: 16px; }
  @media (min-width: 900px) { .ficha__rejilla { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; } }
  .ficha__cartel { padding: 6px 6px 0; }
  .ficha__tipo {
    display: inline-block; border: 3px solid var(--linea); border-radius: 999px; padding: 4px 14px;
    font-weight: 800; color: var(--sobre-color); transform: rotate(-2deg); box-shadow: 3px 3px 0 var(--sombra);
  }
  h1 { margin: 16px 0 20px; font-size: clamp(34px, 5vw, 56px); line-height: 1.02; letter-spacing: -1.5px; font-weight: 800; overflow-wrap: anywhere; }
  dl { margin: 0; display: grid; gap: 10px; }
  dl div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; border-bottom: 2px dashed var(--linea); padding-bottom: 10px; }
  dt { font-weight: 800; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; padding-top: 3px; }
  dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 520px) {
    dl div { grid-template-columns: 1fr; gap: 2px; }
    .ficha__acciones .boton { flex: 1 1 100%; }
    .ficha__mapa iframe { height: 280px; }
  }
  .ficha__acciones { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0; }
  .ficha__pasado {
    margin: 8px 0 0; padding: 12px 16px; max-width: 760px; background: var(--ambar); color: var(--sobre-color);
    border: 3px solid var(--linea); border-radius: var(--radio); box-shadow: 4px 4px 0 var(--sombra); transform: rotate(-.4deg);
  }
  .ficha__pasado a { color: inherit; font-weight: 800; }
  .ficha__plazo {
    display: inline-block; margin: -6px 0 16px; padding: 4px 14px; font-family: var(--mono); font-weight: 800; font-size: 14px;
    background: var(--ambar); color: var(--sobre-color); border: 2px solid var(--linea); border-radius: 999px; transform: rotate(-1deg);
  }
  .ficha__plazo.urgente { background: var(--rosa); }
  .ficha__plazo.cerrado { background: var(--tarjeta); color: var(--suave); border-style: dashed; }
  .ficha__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; padding: 0; }
  .ficha__chips li {
    padding: 2px 12px; border: 2px solid var(--linea); border-radius: 999px; background: var(--lima); color: var(--sobre-color);
    font-weight: 800; font-size: 14px;
  }
  .ficha__chips li:nth-child(even) { background: var(--azul); }
  .ficha__anual { margin: 14px 0 0; font-weight: 600; }
  .ficha__anual a { color: var(--texto); font-weight: 800; }
  .ficha__desc { white-space: pre-line; color: var(--suave); }
  .ficha__fuente { font-size: 14px; color: var(--suave); }
  .ficha__mapa iframe {
    width: 100%; height: 360px; margin-top: 40px;
    border: 3px solid var(--linea); border-radius: var(--radio-grande); box-shadow: 8px 8px 0 var(--sombra);
  }
</style>
