---
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import { GUIAS, type Guia } from '../../lib/guias';
import { PAGINAS_TIPO } from '../../lib/paginas';
import type { Evento } from '../../lib/formato';
import datos from '../../data/eventos.json';

export function getStaticPaths() {
  return GUIAS.map((g) => ({ params: { guia: g.slug }, props: { slug: g.slug } }));
}

const { slug } = Astro.props as { slug: string };
const g = GUIAS.find((x) => x.slug === slug) as Guia;
const listado = g.listado ? PAGINAS_TIPO.find((p) => p.slug === g.listado) : null;
// Al final de la guía, los próximos eventos de ese tipo: de leer a apuntarse en un clic.
const proximos = listado
  ? (datos as unknown as Evento[]).filter(listado.filtro).sort((a, b) => (a.inicio || '9').localeCompare(b.inicio || '9')).slice(0, 3)
  : [];
const otras = GUIAS.filter((x) => x.slug !== slug);
const fecha = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  .format(new Date(`${g.fecha}T00:00:00Z`));

const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: g.titulo, description: g.descripcion,
  datePublished: g.fecha, inLanguage: 'es', author: { '@type': 'Organization', name: 'Todothon', url: Astro.site?.href },
};
const { Content } = g;
---
<Base titulo={`${g.titulo} · Todothon`} descripcion={g.descripcion}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="envoltorio guia">
    <a class="volver" href="/guias">← Todas las guías</a>
    <p class="antetitulo"><span aria-hidden="true">{g.emoji}</span> Guía · {fecha}</p>
    <h1>{g.titulo}</h1>
    <p class="entradilla">{g.descripcion}</p>
    <div class="texto"><Content /></div>

    {proximos.length > 0 && listado && (
      <section class="proximos">
        <h2>Próximos {listado.resalte.toLowerCase() === 'online' ? 'hackathones online' : listado.resalte.toLowerCase()}</h2>
        <div class="rejilla">{proximos.map((e) => <Tarjeta evento={e} />)}</div>
        <a class="boton boton--rosa" href={`/${listado.slug}`}>Ver todos →</a>
      </section>
    )}

    <nav class="otras" aria-label="Más guías">
      <h2>Más guías</h2>
      <ul>{otras.map((x) => <li><a href={`/guias/${x.slug}`}><span aria-hidden="true">{x.emoji}</span> {x.titulo}</a></li>)}</ul>
    </nav>
  </article>
</Base>

<style>
  .guia { padding-top: 32px; display: flex; flex-direction: column; gap: 16px; }
  .volver { font-weight: 700; color: var(--texto); }
  .antetitulo { margin: 0; font-family: var(--mono); font-size: 14px; color: var(--suave); }
  h1 { margin: 0; font-size: clamp(34px, 5.5vw, 58px); line-height: 1.04; letter-spacing: -1.5px; max-width: 900px; }
  .entradilla { margin: 0; font-size: 20px; color: var(--suave); max-width: 720px; }
  .texto {
    max-width: 720px; font-size: 18px; line-height: 1.65;
    padding: 26px 28px; background: var(--tarjeta); border: 3px solid var(--linea);
    border-radius: var(--radio-grande); box-shadow: 8px 8px 0 var(--sombra);
  }
  .texto :global(h2) { margin: 30px 0 8px; font-size: 26px; line-height: 1.2; letter-spacing: -.5px; }
  .texto :global(h2:first-child) { margin-top: 0; }
  .texto :global(p) { margin: 0 0 14px; }
  .texto :global(ul), .texto :global(ol) { margin: 0 0 14px; padding-left: 22px; }
  .texto :global(li) { margin-bottom: 6px; }
  .texto :global(a) { color: var(--texto); font-weight: 700; text-decoration-color: var(--rosa); text-decoration-thickness: 3px; }
  .texto :global(code) { font-family: var(--mono); font-size: .9em; background: var(--lima); color: var(--sobre-color); padding: 1px 6px; border-radius: 6px; }
  h2 { margin: 26px 0 4px; font-size: 26px; letter-spacing: -.5px; }
  .proximos { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .rejilla { width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 32px 28px; }
  .otras ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .otras a { color: var(--texto); font-weight: 700; font-size: 18px; }
  @media (max-width: 520px) { .texto { padding: 20px 18px; font-size: 17px; } }
</style>
