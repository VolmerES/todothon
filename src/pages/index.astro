---
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Fuentes from '../components/Fuentes.astro';
import Campo, { type Opcion } from '../components/Campo.astro';
import Donar from '../components/Donar.astro';
import { PLURALES, TIPOS, TEMAS } from '../config';
import { ciudadCorta, rangoFechas, type Evento } from '../lib/formato';
import datos from '../data/eventos.json';

const eventos = datos as unknown as Evento[];
// Primero lo de España; luego lo online, cada grupo por fecha.
const ordenados = [...eventos].sort((a, b) =>
  (a.pais === 'ES' ? 0 : 1) - (b.pais === 'ES' ? 0 : 1) || (a.inicio || '9').localeCompare(b.inicio || '9'));

// --- Opciones de los desplegables ---------------------------------------------
const sinTildes = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
const ciudades = [...new Set(eventos.filter((e) => e.modalidad !== 'online').map(ciudadCorta))]
  .filter((c) => c !== 'Lugar por confirmar')
  .sort((a, b) => a.localeCompare(b, 'es'));
const opcionesDonde: Opcion[] = [
  { valor: 'online', texto: 'Online' },
  { valor: 'espana', texto: 'En toda España' },
  ...ciudades.map((c) => ({ valor: `c:${sinTildes(c)}`, texto: c })),
];

const nombreMes = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const mesActual = new Date().toISOString().slice(0, 7);
const meses = [...new Set(eventos.map((e) => (e.inicio || '').slice(0, 7)).filter((m) => m && m >= mesActual))].sort().slice(0, 8);
const opcionesCuando: Opcion[] = [
  { valor: 'finde', texto: 'Este finde' },
  { valor: 'semana', texto: 'Próximos 7 días' },
  { valor: 'mes', texto: 'Próximos 30 días' },
  { valor: 'tres', texto: 'Próximos 3 meses' },
  ...meses.map((m) => {
    const t = nombreMes.format(new Date(`${m}-01T00:00:00Z`)).replace(' de ', ' ');
    return { valor: `m:${m}`, texto: t[0].toUpperCase() + t.slice(1) };
  }),
];

const opcionesQue: Opcion[] = Object.entries(TIPOS)
  .filter(([k]) => eventos.some((e) => e.tipo === k))
  .map(([k, t]) => ({ valor: k, texto: t.nombre, color: t.color }));

const opcionesTema: Opcion[] = TEMAS.map((t) => ({ valor: `t:${t.clave}`, texto: t.nombre }));

// --- Puntos del mapa -----------------------------------------------------------
const puntos = eventos
  .filter((e) => e.lat != null && e.lon != null)
  .map((e) => ({
    slug: e.slug, nombre: e.nombre, ciudad: ciudadCorta(e), lat: e.lat, lon: e.lon,
    tipo: TIPOS[e.tipo]?.nombre || 'Evento', color: TIPOS[e.tipo]?.color || TIPOS.otro.color,
    fechas: rangoFechas(e.inicio, e.fin), imagen: e.imagen,
  }));
---
<Base>
  <section class="envoltorio portada">
    <p class="antetitulo entra">España + online · se actualiza cada día</p>
    <h1 class="entra" style="--retraso: .06s">¿A qué <span class="resalte" data-rota="plurales">{PLURALES[0]}</span> te apuntas este finde?</h1>
    <p class="entradilla entra" style="--retraso: .12s">Todos los hackathones, datathones, ideatones, game jams y CTF de España (y los online), en un solo buscador.</p>
  </section>

  <section class="envoltorio" id="buscar" aria-label="Buscador">
    <form class="buscador entra" style="--retraso: .2s" data-buscador role="search" data-temas={JSON.stringify(TEMAS)}>
      <Campo nombre="donde" etiqueta="Dónde" placeholder="Madrid, online…" opciones={opcionesDonde} libre />
      <Campo nombre="cuando" etiqueta="Cuándo" placeholder="Cuando sea" opciones={opcionesCuando} />
      <Campo nombre="que" etiqueta="Qué" placeholder="Todo vale" opciones={opcionesQue} />
      <Campo nombre="tema" etiqueta="Tema" placeholder="IA, salud, juegos…" opciones={opcionesTema} libre />
      <button class="buscador__boton" type="submit">
        <span>Buscar</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="3" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
      </button>
    </form>

    <div class="chips entra" style="--retraso: .3s" role="group" aria-label="Filtros">
      <button type="button" class="boton" aria-pressed="false" data-chip="espana">En España</button>
      <button type="button" class="boton" aria-pressed="false" data-chip="presencial">Presencial</button>
      <button type="button" class="boton" aria-pressed="false" data-chip="online">Online</button>
      <button type="button" class="boton" aria-pressed="false" data-chip="gratis">Gratis</button>
      <button type="button" class="boton" aria-pressed="false" data-chip="premio">Con premios</button>
      <button type="button" class="boton" aria-pressed="false" data-chip="futuro">Aún no ha empezado</button>
    </div>
  </section>

  <section class="envoltorio resultados" id="resultados" aria-label="Resultados">
    <div class="resultados__barra">
      <p class="resultados__cuenta" aria-live="polite">
        <strong data-cuenta>{eventos.length}</strong> <span data-cuenta-texto>eventos encontrados</span>
        <button type="button" class="limpiar" data-limpiar hidden>Quitar filtros ×</button>
      </p>
      <div class="vistas" role="group" aria-label="Vista">
        <button type="button" aria-pressed="true" data-vista="tarjetas">Tarjetas</button>
        <button type="button" aria-pressed="false" data-vista="mapa">Mapa</button>
      </div>
    </div>

    <div class="rejilla" data-panel="tarjetas">
      {ordenados.map((e) => <Tarjeta evento={e} />)}
    </div>
    <p class="vacio" data-vacio hidden>No hay nada con esos filtros. Prueba a quitar alguno, o <a href="/publicar">publica tú el evento</a>.</p>

    <div class="mapa" data-panel="mapa" hidden>
      <div class="mapa__marco">
        <div id="mapa" data-puntos={JSON.stringify(puntos)} aria-label="Mapa de eventos presenciales"></div>
        <p class="mapa__cartela" data-mapa-cartela aria-live="polite"></p>
      </div>
      <p class="mapa__nota">Solo salen los presenciales con dirección. Al alejar se agrupan; al acercar, cada uno en su sitio. Los filtros de arriba también valen aquí.</p>
    </div>
  </section>

  <section class="envoltorio apoyo">
    <Donar />
  </section>

  <Fuentes eventos={eventos} />
</Base>

<style>
  .portada { padding: 32px 16px 12px; display: flex; flex-direction: column; gap: 16px; }
  .antetitulo { margin: 0; font-family: var(--mono); font-size: 14px; color: var(--suave); }
  h1 { margin: 0; font-size: clamp(40px, 7vw, 76px); line-height: 1; font-weight: 800; letter-spacing: -2px; max-width: 1000px; }
  .resalte {
    display: inline-block; background: var(--lima); color: var(--sobre-color);
    border: 3px solid var(--linea); border-radius: var(--radio); padding: 0 12px;
    box-shadow: 5px 5px 0 var(--sombra); transform: rotate(var(--giro, 1.5deg));
  }
  .entradilla { margin: 0; font-size: 20px; color: var(--suave); max-width: 680px; }

  /* Buscador: las líneas entre campos son el fondo negro asomando por el hueco de 3 px. */
  .buscador {
    margin-top: 24px; display: grid; grid-template-columns: 1fr; gap: 3px;
    background: var(--linea); border: 3px solid var(--linea); border-radius: var(--radio-grande);
    box-shadow: 8px 8px 0 var(--sombra); overflow: hidden;
  }
  .buscador:global(.sin-popover) { overflow: visible; }
  @media (min-width: 560px) {
    .buscador { grid-template-columns: 1fr 1fr; }
    .buscador__boton { grid-column: 1 / -1; }
  }
  @media (min-width: 980px) {
    .buscador { grid-template-columns: 1.15fr 1fr 1fr 1.15fr auto; }
    .buscador__boton { grid-column: auto; padding: 0 30px; }
  }
  .buscador__boton {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 68px; border: 0; cursor: pointer;
    background: var(--rosa); color: var(--sobre-color); font-size: 20px; font-weight: 800;
    transition: background .15s ease;
  }
  .buscador__boton:hover { background: var(--lima); }
  .buscador__boton:active span { display: inline-block; transform: scale(.9); }
  .buscador__boton svg { transition: transform .3s var(--rebote); }
  .buscador__boton:hover svg { transform: rotate(-18deg) scale(1.2); }
  @media (prefers-reduced-motion: no-preference) {
    .buscador__boton:hover svg { animation: lupa .7s ease-in-out infinite alternate; }
    @keyframes lupa { to { translate: 3px -2px; } }
  }

  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0; }
  .resultados { margin-top: 32px; }
  .resultados__barra { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; }
  .resultados__cuenta { margin: 0; font-size: 18px; font-weight: 600; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .limpiar {
    min-height: 36px; padding: 4px 12px; cursor: pointer; font-weight: 800; font-size: 15px;
    background: var(--ambar); border: 2px solid var(--linea); border-radius: 999px; box-shadow: 2px 2px 0 var(--sombra);
    transform: rotate(-2deg);
  }
  .limpiar[hidden] { display: none; }
  .limpiar { transition: transform .2s var(--rebote); }
  .limpiar:hover { transform: rotate(2deg) scale(1.06); }
  @media (prefers-reduced-motion: no-preference) {
    .limpiar:not([hidden]) { animation: sello .35s var(--rebote); }
  }
  .vistas { display: flex; border: 2px solid var(--linea); border-radius: 999px; overflow: hidden; }
  .vistas button { border: 0; background: var(--tarjeta); padding: 10px 20px; min-height: 44px; font-weight: 700; cursor: pointer; }
  .vistas button { transition: background-color .2s ease, color .2s ease; }
  .vistas button:active { transform: scale(.94); }
  .vistas button[aria-pressed="true"] { background: var(--texto); color: var(--fondo); }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 32px 28px; }
  .vacio { font-size: 18px; font-weight: 600; }

  .mapa__marco { position: relative; }
  #mapa {
    height: min(72vh, 640px); border: 3px solid var(--linea); border-radius: var(--radio-grande);
    box-shadow: 8px 8px 0 var(--sombra); background: #EAE4D3;
  }
  .mapa__cartela {
    position: absolute; z-index: 500; top: 14px; left: 60px; margin: 0; max-width: calc(100% - 80px);
    background: var(--tarjeta); border: 3px solid var(--linea); border-radius: var(--radio);
    box-shadow: 4px 4px 0 var(--sombra); padding: 6px 12px; font-weight: 700; font-size: 15px;
    transform: rotate(-1deg); pointer-events: none;
  }
  .mapa__cartela:empty { display: none; }
  .mapa__nota { color: var(--suave); font-size: 15px; }
  .apoyo { margin-top: 64px; }
</style>

<script>
  type Item = {
    el: HTMLElement; slug: string; tipo: string; modalidad: string; ciudad: string; es: boolean;
    inicio: string; fin: string; gratis: boolean; premio: boolean; texto: string; ok: boolean;
  };
  type Estado = { donde: string; cuando: string; que: string; tema: string; chips: Set<string> };
  type Clave = 'donde' | 'cuando' | 'que' | 'tema';

  const sinTildes = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
  const form = document.querySelector<HTMLFormElement>('[data-buscador]')!;
  const cuenta = document.querySelector('[data-cuenta]')!;
  const cuentaTexto = document.querySelector('[data-cuenta-texto]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const limpiar = document.querySelector<HTMLButtonElement>('[data-limpiar]')!;
  const chips = new Set<string>();
  let vista = 'tarjetas';
  let primera = true; // en la primera pasada también entran las de arriba

  const temas = new Map<string, RegExp>(
    (JSON.parse(form.dataset.temas || '[]') as { clave: string; patron: string }[])
      .map((t) => [`t:${t.clave}`, new RegExp(t.patron, 'i')]));

  const items: Item[] = [...document.querySelectorAll<HTMLElement>('[data-evento]')].map((el) => {
    const d = el.dataset;
    return {
      el, slug: d.slug || '', tipo: d.tipo || '', modalidad: d.modalidad || '', ciudad: sinTildes(d.ciudad || ''),
      es: d.es === '1', inicio: d.inicio || '', fin: d.fin || '', gratis: d.gratis === '1', premio: d.premio === '1',
      texto: sinTildes(d.texto || ''), ok: true,
    };
  });

  // --- Fechas ------------------------------------------------------------------
  function hoyMas(dias: number) { const d = new Date(); d.setUTCDate(d.getUTCDate() + dias); return d.toISOString().slice(0, 10); }
  function rangoCuando(v: string): [string, string] | null {
    const hoy = hoyMas(0);
    if (v === 'semana') return [hoy, hoyMas(7)];
    if (v === 'mes') return [hoy, hoyMas(30)];
    if (v === 'tres') return [hoy, hoyMas(90)];
    if (v.startsWith('m:')) return [`${v.slice(2)}-01`, `${v.slice(2)}-31`];
    if (v === 'finde') {
      // De viernes a domingo; si ya es finde, desde hoy hasta el domingo.
      const dow = new Date().getUTCDay(); // 0 = domingo, 6 = sábado
      if (dow === 0) return [hoy, hoy];
      if (dow >= 5) return [hoy, hoyMas(7 - dow)];
      return [hoyMas(5 - dow), hoyMas(7 - dow)];
    }
    return null;
  }

  // --- El filtro ------------------------------------------------------------------
  function pasa(i: Item, s: Estado): boolean {
    const hoy = hoyMas(0);
    if (s.donde) {
      if (s.donde === 'online') { if (i.modalidad === 'presencial') return false; }
      else if (s.donde === 'espana') { if (!i.es) return false; }
      else if (s.donde.startsWith('c:')) { if (i.ciudad !== s.donde.slice(2)) return false; }
      else { const q = sinTildes(s.donde); if (!i.ciudad.includes(q) && !i.texto.includes(q)) return false; }
    }
    if (s.tema) {
      const re = temas.get(s.tema);
      if (re ? !re.test(i.texto) : !i.texto.includes(sinTildes(s.tema))) return false;
    }
    if (s.que && i.tipo !== s.que) return false;
    const rango = rangoCuando(s.cuando);
    if (rango && !(i.inicio <= rango[1] && i.fin >= rango[0])) return false;
    if (s.chips.has('espana') && !i.es) return false;
    if (s.chips.has('presencial') && i.modalidad === 'online') return false;
    if (s.chips.has('online') && i.modalidad === 'presencial') return false;
    if (s.chips.has('gratis') && !i.gratis) return false;
    if (s.chips.has('premio') && !i.premio) return false;
    if (s.chips.has('futuro') && !(i.inicio > hoy)) return false;
    return true;
  }

  // --- Desplegables -----------------------------------------------------------------
  const conPopover = typeof HTMLElement.prototype.showPopover === 'function';
  if (!conPopover) form.classList.add('sin-popover');

  type Campo = ReturnType<typeof montarCampo>;
  const campos: Campo[] = [];

  function montarCampo(el: HTMLElement) {
    const nombre = el.dataset.campo as Clave;
    const libre = el.hasAttribute('data-libre');
    const texto = el.querySelector<HTMLInputElement>('.campo__texto')!;
    const oculto = el.querySelector<HTMLInputElement>('input[type="hidden"]')!;
    const lista = el.querySelector<HTMLElement>('.lista')!;
    const borrar = el.querySelector<HTMLButtonElement>('.campo__borrar')!;
    const nada = lista.querySelector<HTMLElement>('.lista__nada')!;
    const opciones = [...lista.querySelectorAll<HTMLLIElement>('[role="option"]')];
    if (!conPopover) lista.hidden = true;
    let activa = -1;

    const abierta = () => texto.getAttribute('aria-expanded') === 'true';
    const visibles = () => opciones.filter((o) => !o.hidden);
    const textoDe = (valor: string) => opciones.find((o) => o.dataset.valor === valor)?.dataset.texto;

    function colocar() {
      if (!conPopover || !abierta()) return;
      const r = el.getBoundingClientRect();
      const ancho = Math.min(Math.max(r.width, 280), innerWidth - 16);
      lista.style.width = `${ancho}px`;
      lista.style.left = `${Math.max(8, Math.min(r.left, innerWidth - ancho - 8))}px`;
      const abajo = innerHeight - r.bottom - 16;
      const arriba = r.top - 16;
      if (abajo < 200 && arriba > abajo) {
        lista.style.top = 'auto';
        lista.style.bottom = `${innerHeight - r.top + 6}px`;
        lista.style.maxHeight = `${Math.min(340, arriba)}px`;
      } else {
        lista.style.bottom = 'auto';
        lista.style.top = `${r.bottom + 6}px`;
        lista.style.maxHeight = `${Math.min(340, abajo)}px`;
      }
    }
    function filtrarOpciones() {
      // Si lo escrito es la opción ya elegida, se enseñan todas.
      const q = libre && texto.value !== textoDe(oculto.value) ? sinTildes(texto.value) : '';
      let n = 0;
      for (const o of opciones) {
        o.hidden = !!q && !sinTildes(o.dataset.texto || '').includes(q);
        if (!o.hidden) n++;
      }
      nada.hidden = n > 0;
    }
    function marcar(idx: number) {
      const vs = visibles();
      opciones.forEach((o) => o.classList.remove('activa'));
      activa = idx;
      const o = vs[idx];
      if (o) {
        o.classList.add('activa');
        texto.setAttribute('aria-activedescendant', o.id);
        o.scrollIntoView({ block: 'nearest' });
      } else texto.removeAttribute('aria-activedescendant');
    }
    function abrir() {
      if (abierta()) return;
      campos.forEach((c) => c.nombre !== nombre && c.cerrar());
      filtrarOpciones();
      texto.setAttribute('aria-expanded', 'true');
      if (conPopover) lista.showPopover(); else lista.hidden = false;
      colocar();
      marcar(visibles().findIndex((o) => o.dataset.valor === oculto.value));
    }
    function cerrar() {
      if (!abierta()) return;
      texto.setAttribute('aria-expanded', 'false');
      if (conPopover) lista.hidePopover(); else lista.hidden = true;
      marcar(-1);
    }
    function poner(valor: string) {
      oculto.value = valor;
      texto.value = valor ? (textoDe(valor) ?? valor) : '';
      borrar.hidden = !valor;
      opciones.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.valor === valor)));
    }
    function elegir(o: HTMLElement) {
      poner(o.dataset.valor || '');
      cerrar();
      filtrar();
    }

    texto.addEventListener('click', () => (libre || !abierta() ? abrir() : cerrar()));
    texto.addEventListener('input', () => {
      oculto.value = texto.value.trim();
      borrar.hidden = !oculto.value;
      opciones.forEach((o) => o.setAttribute('aria-selected', 'false'));
      if (!abierta()) abrir(); else filtrarOpciones();
      marcar(-1);
      filtrar();
    });
    texto.addEventListener('keydown', (ev) => {
      const vs = visibles();
      switch (ev.key) {
        case 'ArrowDown':
          ev.preventDefault();
          if (!abierta()) abrir(); else marcar(Math.min(activa + 1, vs.length - 1));
          break;
        case 'ArrowUp':
          ev.preventDefault();
          if (abierta()) marcar(Math.max(activa - 1, 0));
          break;
        case 'Home': case 'End':
          if (abierta() && !libre) { ev.preventDefault(); marcar(ev.key === 'Home' ? 0 : vs.length - 1); }
          break;
        case 'Enter':
          if (abierta() && vs[activa]) { ev.preventDefault(); elegir(vs[activa]); }
          else if (!libre) { ev.preventDefault(); abrir(); }
          else cerrar();
          break;
        case ' ':
          if (!libre) {
            ev.preventDefault();
            if (!abierta()) abrir(); else if (vs[activa]) elegir(vs[activa]); else cerrar();
          }
          break;
        case 'Escape':
          if (abierta()) { ev.preventDefault(); cerrar(); }
          break;
      }
    });
    el.addEventListener('focusout', (ev) => { if (!el.contains(ev.relatedTarget as Node)) cerrar(); });
    el.addEventListener('click', (ev) => { if (ev.target === el) texto.focus(); });
    lista.addEventListener('pointerdown', (ev) => ev.preventDefault()); // que el campo no pierda el foco
    lista.addEventListener('click', (ev) => {
      const o = (ev.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      if (o) elegir(o);
    });
    borrar.addEventListener('click', () => { poner(''); filtrar(); texto.focus(); });

    return {
      nombre, poner, cerrar, colocar,
      valor: () => oculto.value,
      contar(s: Estado) {
        for (const o of opciones) {
          const prueba = { ...s, [nombre]: o.dataset.valor || '' };
          let n = 0;
          for (const i of items) if (pasa(i, prueba)) n++;
          o.querySelector('[data-n]')!.textContent = String(n);
          o.classList.toggle('vacia', n === 0);
        }
      },
    };
  }

  form.querySelectorAll<HTMLElement>('[data-campo]').forEach((el) => campos.push(montarCampo(el)));
  const campo = (n: Clave) => campos.find((c) => c.nombre === n)!;
  addEventListener('resize', () => campos.forEach((c) => c.colocar()));
  addEventListener('scroll', () => campos.forEach((c) => c.colocar()), { passive: true });

  function estado(): Estado {
    return { donde: campo('donde').valor(), cuando: campo('cuando').valor(), que: campo('que').valor(), tema: campo('tema').valor(), chips };
  }

  function guardarUrl(s: Estado) {
    const p = new URLSearchParams();
    for (const c of campos) if (c.valor()) p.set(c.nombre, c.valor());
    if (s.chips.size) p.set('f', [...s.chips].join(','));
    if (vista === 'mapa') p.set('vista', 'mapa');
    const q = p.toString();
    history.replaceState(null, '', `${location.pathname}${q ? `?${q}` : ''}${location.hash}`);
  }

  function filtrar() {
    const s = estado();
    let n = 0;
    let nuevas = 0;
    for (const i of items) {
      const antes = !i.el.hidden;
      i.ok = pasa(i, s);
      i.el.hidden = !i.ok;
      if (i.ok) n++;
      if (i.ok && (!antes || primera) && nuevas < 12) {
        // Las que entran en la lista caen como pegatinas, una detrás de otra.
        i.el.classList.remove('entra');
        void i.el.offsetWidth;
        i.el.style.setProperty('--retraso', `${(primera ? 0.3 : 0) + nuevas * 0.04}s`);
        i.el.classList.add('entra');
        nuevas++;
      }
    }
    primera = false;
    cuenta.textContent = String(n);
    cuentaTexto.textContent = n === 1 ? 'evento encontrado' : 'eventos encontrados';
    vacio.hidden = n > 0 || vista === 'mapa';
    limpiar.hidden = !(campos.some((c) => c.valor()) || chips.size);
    campos.forEach((c) => c.contar(s));
    guardarUrl(s);
    if (mapa) pintarMapa();
  }

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    campos.forEach((c) => c.cerrar());
    filtrar();
    document.getElementById('resultados')?.scrollIntoView({ behavior: 'smooth' });
  });
  const botonesChip = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  botonesChip.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.chip!;
    const activo = !chips.has(k);
    activo ? chips.add(k) : chips.delete(k);
    b.setAttribute('aria-pressed', String(activo));
    filtrar();
  }));
  limpiar.addEventListener('click', () => {
    campos.forEach((c) => c.poner(''));
    chips.clear();
    botonesChip.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    filtrar();
  });

  // --- Mapa: se carga solo cuando hace falta y obedece a los mismos filtros ---------------
  type Punto = { slug: string; nombre: string; ciudad: string; lat: number; lon: number; tipo: string; color: string; fechas: string; imagen: string | null };
  let mapa: any = null;
  let grupo: any = null;
  let Lf: any = null;
  let cargando: Promise<void> | null = null;
  const marcadores = new Map<string, any>();
  const cartela = document.querySelector<HTMLElement>('[data-mapa-cartela]')!;

  function ficha(p: Punto) {
    const caja = document.createElement('div');
    caja.className = 'ficha-mapa';
    if (p.imagen) {
      const marco = document.createElement('a');
      marco.className = 'ficha-mapa__cartel';
      marco.href = `/evento/${p.slug}`;
      marco.tabIndex = -1;
      const img = document.createElement('img');
      img.src = p.imagen; img.alt = ''; img.loading = 'lazy'; img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => marco.remove());
      marco.append(img);
      caja.append(marco);
    }
    const tipo = document.createElement('span');
    tipo.className = 'ficha-mapa__tipo';
    tipo.style.background = p.color;
    tipo.textContent = p.tipo;
    const nombre = document.createElement('a');
    nombre.className = 'ficha-mapa__nombre';
    nombre.href = `/evento/${p.slug}`;
    nombre.textContent = p.nombre;
    const cuando = document.createElement('p');
    cuando.className = 'ficha-mapa__cuando';
    cuando.textContent = `${p.fechas} · ${p.ciudad}`;
    const ver = document.createElement('a');
    ver.className = 'ficha-mapa__ver';
    ver.href = `/evento/${p.slug}`;
    ver.textContent = 'Ver ficha →';
    caja.append(tipo, nombre, cuando, ver);
    return caja;
  }

  async function cargarMapa() {
    const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
    (window as unknown as { L: typeof L }).L = L;
    await Promise.all([import('leaflet.markercluster'), import('leaflet.markercluster/dist/MarkerCluster.css')]);
    Lf = L;
    const el = document.getElementById('mapa')!;
    const puntos: Punto[] = JSON.parse(el.dataset.puntos || '[]');
    mapa = L.map(el, { scrollWheelZoom: false }).setView([40.2, -3.7], 6);
    mapa.on('focus click', () => mapa.scrollWheelZoom.enable());
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mapa);
    grupo = (L as any).markerClusterGroup({
      showCoverageOnHover: false,
      maxClusterRadius: 50,
      iconCreateFunction: (c: any) => {
        const n = c.getChildCount();
        const t = n < 5 ? 44 : n < 20 ? 52 : 60;
        return L.divIcon({ className: 'grupo-pegatina', html: `<span>${n}</span>`, iconSize: [t, t] });
      },
    });
    for (const p of puntos) {
      const icono = L.divIcon({
        className: 'chincheta',
        html: `<span style="background:${p.color}"></span>`,
        iconSize: [30, 38], iconAnchor: [15, 36], popupAnchor: [0, -32],
      });
      const m = L.marker([p.lat, p.lon], { icon: icono, title: p.nombre, alt: p.nombre })
        .bindPopup(() => ficha(p), { minWidth: 220, maxWidth: 240, className: 'popup-pegatina' });
      marcadores.set(p.slug, m);
    }
    mapa.addLayer(grupo);
  }

  function pintarMapa() {
    if (!mapa) return;
    const visibles = items.filter((i) => i.ok);
    const ms = visibles.map((i) => marcadores.get(i.slug)).filter(Boolean);
    grupo.clearLayers();
    grupo.addLayers(ms);
    const online = visibles.filter((i) => i.modalidad === 'online').length;
    const sinSitio = visibles.length - ms.length - online;
    const partes = [`${ms.length} en el mapa`];
    if (online) partes.push(`${online} online`);
    if (sinSitio > 0) partes.push(`${sinSitio} sin dirección`);
    cartela.textContent = partes.join(' · ');
    if (ms.length) mapa.fitBounds(Lf.latLngBounds(ms.map((m: any) => m.getLatLng())), { padding: [50, 50], maxZoom: 13 });
    else mapa.setView([40.2, -3.7], 6);
  }

  async function verMapa() {
    cargando ||= cargarMapa();
    await cargando;
    mapa.invalidateSize();
    pintarMapa();
  }

  function cambiarVista(v: string) {
    vista = v;
    document.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vista === v)));
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== v; });
    filtrar();
    if (v === 'mapa') verMapa();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((b) => b.addEventListener('click', () => cambiarVista(b.dataset.vista!)));

  // --- Estado inicial desde la URL (las búsquedas se pueden compartir) --------------------
  const p = new URLSearchParams(location.search);
  for (const c of campos) c.poner(p.get(c.nombre) || '');
  for (const k of (p.get('f') || '').split(',').filter(Boolean)) {
    const b = botonesChip.find((x) => x.dataset.chip === k);
    if (b) { chips.add(k); b.setAttribute('aria-pressed', 'true'); }
  }
  if (p.get('vista') === 'mapa') cambiarVista('mapa'); else filtrar();
</script>

<style is:global>
  /* Las teselas de Leaflet no pueden llevar el max-width global de las imágenes (salen rayas). */
  .leaflet-container img { max-width: none !important; }
