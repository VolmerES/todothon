  .chincheta span {
    display: block; width: 26px; height: 26px; margin: 2px;
    border-radius: 50% 50% 50% 0; transform: rotate(-45deg);
    border: 3px solid var(--linea); box-shadow: 2px 2px 0 var(--sombra);
    transition: transform .12s ease;
  }
  .chincheta:hover span, .chincheta:focus span { transform: rotate(-45deg) scale(1.15); }
  @media (prefers-reduced-motion: no-preference) {
    .chincheta span { animation: chincheta .45s var(--rebote) both; }
    @keyframes chincheta { from { translate: 0 -28px; opacity: 0; } 70% { opacity: 1; } }
    .grupo-pegatina span { animation: grupo .4s var(--rebote) both; }
    @keyframes grupo { from { scale: .3; opacity: 0; } }
    .popup-pegatina { animation: grupo .3s var(--rebote); }
  }
  .grupo-pegatina span {
    display: grid; place-items: center; width: 100%; height: 100%;
    background: var(--lima); color: var(--sobre-color); font: 800 17px var(--letra);
    border: 3px solid var(--linea); border-radius: 50%; box-shadow: 3px 3px 0 var(--sombra);
    transform: rotate(-6deg);
  }
  .leaflet-bar { border: 3px solid var(--linea) !important; border-radius: 12px !important; box-shadow: 3px 3px 0 var(--sombra) !important; overflow: hidden; }
  .leaflet-bar a { color: var(--texto) !important; font-weight: 800; }
  .popup-pegatina .leaflet-popup-content-wrapper {
    background: var(--tarjeta); border: 3px solid var(--linea); border-radius: var(--radio);
    box-shadow: 5px 5px 0 var(--sombra);
  }
  .popup-pegatina .leaflet-popup-tip { background: var(--tarjeta); border: 3px solid var(--linea); box-shadow: none; }
  .popup-pegatina .leaflet-popup-content { margin: 12px; font-family: var(--letra); font-size: 15px; line-height: 1.35; }
  .popup-pegatina a.leaflet-popup-close-button { color: var(--texto); font-weight: 800; top: 6px; right: 6px; }
  .ficha-mapa { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .ficha-mapa__cartel { display: block; width: 100%; padding: 5px; background: #fff; border: 2px solid var(--linea); transform: rotate(-1.5deg); }
  .ficha-mapa__cartel img { width: 100%; aspect-ratio: 16 / 10; object-fit: contain; background: #f2f2f2; }
  .ficha-mapa__tipo { border: 2px solid var(--linea); border-radius: 999px; padding: 0 10px; font-weight: 800; font-size: 13px; margin-top: 4px; }
  .ficha-mapa__nombre { font-weight: 800; font-size: 17px; color: var(--texto) !important; text-decoration: none; }
  .ficha-mapa__nombre:hover { text-decoration: underline; }
  .ficha-mapa__cuando { margin: 0 !important; color: var(--suave); }
  .ficha-mapa__ver { font-weight: 800; color: var(--texto) !important; background: var(--lima); border: 2px solid var(--linea); border-radius: 999px; padding: 2px 12px; text-decoration: none; }
</style>
