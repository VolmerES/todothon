---
import '../styles/global.css';
import '../styles/terminal.css';
import Consola from '../components/Consola.astro';
import { URL_DONAR, URL_TELEGRAM, URL_REPO, PALABRAS, AUTOR } from '../config';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string | null;
}
const {
  titulo = 'Todothon · Hackathones, datathones, game jams y CTF de España',
  descripcion = 'Todos los hackathones, datathones, ideatones, game jams y CTF de España y online, en un solo buscador. Sin ánimo de lucro y de la comunidad.',
  imagen = null,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es" data-theme="pegatina">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonica} />
  {imagen && <meta property="og:image" content={imagen} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=JetBrains+Mono:wght@600;800&display=swap" />
  <slot name="head" />
  <!-- El modo elegido se aplica antes de pintar nada, para que no parpadee al cargar. -->
  <script is:inline>try { if (localStorage.getItem('todothon-tema') === 'terminal') document.documentElement.dataset.theme = 'terminal'; } catch {}</script>
</head>
<body>
  <header class="cabecera" data-cabecera>
    <div class="envoltorio cabecera__fila">
      <a class="logo" href="/" aria-label="Todothon, inicio">
        <span class="logo__palabra" data-rota="palabras" aria-hidden="true">{PALABRAS[0]}</span><span class="logo__resto" aria-hidden="true">thon</span>
      </a>
      <!-- En el móvil, el menú se abre con esta pegatina; en el ordenador no se ve. -->
      <button type="button" class="menu-boton" aria-expanded="false" aria-controls="menu-principal" data-menu-boton>
        <span class="menu-boton__barras" aria-hidden="true"><span></span><span></span><span></span></span>
        <span data-menu-texto>Menú</span>
      </button>
      <nav class="nav" id="menu-principal" aria-label="Principal">
        <a href="/#buscar">Explorar</a>
        <a href="/?vista=mapa#resultados">Mapa</a>
        <a href="/guias">Guías</a>
        <a href="/sobre">Sobre</a>
        <a href={URL_TELEGRAM} rel="noopener">Telegram</a>
        <a class="boton boton--negro" href="/publicar">Publica tu evento</a>
        <button type="button" class="boton-terminal" data-terminal aria-pressed="false">&gt;_ modo terminal</button>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="pie">
    <div class="envoltorio pie__fila">
      <p><span class="pie__marca">Todothon</span> · sin ánimo de lucro, de la comunidad.</p>
      <p><a href="/sobre">Sobre el proyecto</a> · <a href={URL_DONAR} rel="noopener">Invitar a 1 €</a> · <a href={URL_REPO} rel="noopener">Código en GitHub</a> · <a href="/publicar">Publicar un evento</a></p>
    </div>
    <nav class="envoltorio pie__busquedas" aria-label="Buscar por tipo y ciudad">
      <a href="/hackathones-espana">Hackathones en España</a>
      <a href="/hackathones-online">Hackathones online</a>
      <a href="/game-jams">Game jams</a>
      <a href="/ctf">CTF</a>
      <a href="/datathones">Datathones</a>
      <a href="/hackathones-madrid">Madrid</a>
      <a href="/hackathones-barcelona">Barcelona</a>
      <a href="/hackathones-valencia">Valencia</a>
      <a href="/hackathones-sevilla">Sevilla</a>
      <a href="/hackathones-bilbao">Bilbao</a>
      <a href="/guias">Guías</a>
    </nav>
    <div class="envoltorio pie__firma">
      <p>Desarrollado con cariño (y pocas horas de sueño) por <a class="firma" href={AUTOR.url} rel="author noopener">{AUTOR.nombre}</a></p>
    </div>
  </footer>

  <div class="aviso" role="status" aria-live="polite" hidden data-aviso></div>
  <Consola />

  <script>
    import { PALABRAS, PLURALES } from '../config';

    // La palabra que va cambiando: Hack·thon → Data·thon → Idea·thon…
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!quieto) {
      let i = 0;
      let giroPrevio = 0;
      // Cada palabra nueva se pega torcida hacia un lado distinto (entre 3° y 8°, alternando el sentido).
      const nuevoGiro = () => {
        const sentido = giroPrevio > 0 ? -1 : 1;
        giroPrevio = sentido * (3 + Math.random() * 5);
        return `${giroPrevio.toFixed(1)}deg`;
      };
      // La vieja se despega (.despega) y, al acabar, la nueva se estampa (.pega). Los estilos, en global.css.
      const cambiar = (el: HTMLElement, palabra: string, giro: string) => {
        el.classList.remove('pega');
        el.classList.add('despega');
        setTimeout(() => {
          el.textContent = palabra;
          el.style.setProperty('--giro', giro);
          el.classList.remove('despega');
          void el.offsetWidth; // reinicia la animación
          el.classList.add('pega');
        }, 160);
      };
      setInterval(() => {
        i++;
        const giro = nuevoGiro();
        document.querySelectorAll<HTMLElement>('[data-rota="palabras"]').forEach((el) => cambiar(el, PALABRAS[i % PALABRAS.length], giro));
        document.querySelectorAll<HTMLElement>('[data-rota="plurales"]').forEach((el) =>
          cambiar(el, PLURALES[i % PLURALES.length], `${(-parseFloat(giro) / 2).toFixed(1)}deg`));
      }, 2200);
    }

    // Menú del móvil: abre y cierra el panel, bloquea el scroll de detrás y se cierra con Esc o al elegir algo.
    const cabecera = document.querySelector<HTMLElement>('[data-cabecera]')!;
    const botonMenu = cabecera.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
    const textoMenu = cabecera.querySelector<HTMLElement>('[data-menu-texto]')!;
    function menu(abrir: boolean) {
      cabecera.toggleAttribute('data-abierto', abrir);
      document.documentElement.classList.toggle('sin-scroll', abrir);
      botonMenu.setAttribute('aria-expanded', String(abrir));
      textoMenu.textContent = abrir ? 'Cerrar' : 'Menú';
    }
    botonMenu.addEventListener('click', () => menu(!cabecera.hasAttribute('data-abierto')));
    cabecera.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => menu(false)));
    cabecera.querySelector('[data-terminal]')?.addEventListener('click', () => menu(false));
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && cabecera.hasAttribute('data-abierto')) { menu(false); botonMenu.focus(); }
    });
    // Si se gira el móvil o se agranda la ventana con el menú abierto, que no se quede bloqueado.
    matchMedia('(min-width: 861px)').addEventListener('change', (m) => { if (m.matches) menu(false); });

    // Avisos flotantes. El modo terminal está en components/Consola.astro.
    const aviso = document.querySelector<HTMLElement>('[data-aviso]');
    let temporizador: ReturnType<typeof setTimeout> | undefined;
    function avisar(texto: string) {
      if (!aviso) return;
      aviso.textContent = texto;
      aviso.hidden = false;
      clearTimeout(temporizador);
      temporizador = setTimeout(() => { aviso.hidden = true; }, 3500);
    }
    // Huevo de pascua: escribir «sudo» en cualquier buscador (fuera de la consola).
    document.addEventListener('input', (ev) => {
      const t = ev.target as HTMLInputElement;
      if (t?.tagName === 'INPUT' && !t.closest('[data-consola]') && /sudo/i.test(t.value)) avisar('> sudo: permiso denegado. Prueba el modo terminal de arriba_');
    });
  </script>
</body>
</html>
