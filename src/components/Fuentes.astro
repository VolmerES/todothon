---
// Carrusel con las webs de las que salen los eventos: una cinta de pegatinas que se desplaza sola.
// Con «reducir movimiento» activado, las pegatinas se quedan quietas y se reparten en varias filas.
import { FUENTES } from '../config';
import type { Evento } from '../lib/formato';
import { existsSync } from 'node:fs';

interface Props { eventos: Evento[] }
const { eventos } = Astro.props;

const cuenta = (f: string) => eventos.filter((e) => (e.fuente || '').split(', ').includes(f)).length;
const colores = ['var(--rosa)', 'var(--lima)', 'var(--ambar)', 'var(--azul)', '#B8A6FF', 'var(--tarjeta)'];
const lista = FUENTES
  .map((f) => ({ ...f, n: cuenta(f.fuente) }))
  .filter((f) => f.n > 0 || f.fuente === 'Todothon')
  .map((f, i) => ({ ...f, color: colores[i % colores.length], giro: `${[-3, 2, -1, 3, -2, 1][i % 6]}deg` }));
// Logo de cada web (su favicon, guardado en public/logos/ para no llamar a terceros desde la página).
const nombreLogo = (f: string) => f.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const logo = (f: string) => (existsSync(`public/logos/${nombreLogo(f)}.png`) ? `/logos/${nombreLogo(f)}.png` : null);
const icono: Record<string, string> = { 'Búsqueda IA': '✨', Todothon: '✋' };
const etiqueta = (f: (typeof lista)[number]) => (f.fuente === 'Todothon' ? 'Lo que publicáis vosotros' : f.fuente);
// Con pocas fuentes, cada pista se rellena repitiéndolas para que la cinta no deje huecos al dar la vuelta.
const vueltas = Math.max(1, Math.ceil(14 / lista.length));
const relleno = Array.from({ length: vueltas - 1 }, () => lista).flat();
---
<section class="fuentes" aria-labelledby="fuentes-titulo">
  <div class="envoltorio">
    <h2 id="fuentes-titulo">Lo juntamos todo de <span>{lista.length - 1} webs</span> y de vosotros</h2>
  </div>
  <div class="cinta">
    <ul class="cinta__pista">
      {lista.map((f) => (
        <li>
          <a class="sello" href={f.url} rel="noopener" style={`background: ${f.color}; --giro: ${f.giro}`}>
            {logo(f.fuente) ? <img class="sello__logo" src={logo(f.fuente)} alt="" width="28" height="28" loading="lazy" /> : <span class="sello__logo sello__logo--icono" aria-hidden="true">{icono[f.fuente] || '•'}</span>}
            <strong>{etiqueta(f)}</strong>
            {f.fuente !== 'Todothon' && <span>{f.n} {f.n === 1 ? 'evento' : 'eventos'}</span>}
          </a>
        </li>
      ))}
      {relleno.map((f) => (
        <li class="repetida" aria-hidden="true">
          <a class="sello" href={f.url} tabindex="-1" style={`background: ${f.color}; --giro: ${f.giro}`}>
            {logo(f.fuente) ? <img class="sello__logo" src={logo(f.fuente)} alt="" width="28" height="28" loading="lazy" /> : <span class="sello__logo sello__logo--icono" aria-hidden="true">{icono[f.fuente] || '•'}</span>}
            <strong>{etiqueta(f)}</strong>
            {f.fuente !== 'Todothon' && <span>{f.n} {f.n === 1 ? 'evento' : 'eventos'}</span>}
          </a>
        </li>
      ))}
    </ul>
    <ul class="cinta__pista cinta__pista--copia" aria-hidden="true">
      {[...lista, ...relleno].map((f) => (
        <li>
          <a class="sello" href={f.url} tabindex="-1" style={`background: ${f.color}; --giro: ${f.giro}`}>
            {logo(f.fuente) ? <img class="sello__logo" src={logo(f.fuente)} alt="" width="28" height="28" loading="lazy" /> : <span class="sello__logo sello__logo--icono" aria-hidden="true">{icono[f.fuente] || '•'}</span>}
            <strong>{etiqueta(f)}</strong>
            {f.fuente !== 'Todothon' && <span>{f.n} {f.n === 1 ? 'evento' : 'eventos'}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .fuentes { margin: 48px 0 8px; }
  h2 { margin: 0 0 18px; font-size: clamp(24px, 3.4vw, 34px); letter-spacing: -.5px; line-height: 1.15; }
  h2 span { background: var(--rosa); border: 3px solid var(--linea); padding: 0 8px; border-radius: 10px; display: inline-block; transform: rotate(-1.5deg); }
  .cinta {
    display: flex; overflow: hidden; padding: 14px 0 20px;
    border-top: 3px solid var(--linea); border-bottom: 3px solid var(--linea); background: var(--tarjeta);
  }
  .cinta:hover .cinta__pista, .cinta:focus-within .cinta__pista { animation-play-state: paused; }
  .cinta__pista {
    list-style: none; margin: 0; padding: 0 0 0 20px; display: flex; gap: 20px; flex-shrink: 0;
    animation: desplazar 38s linear infinite;
  }
  @keyframes desplazar { to { transform: translateX(-100%); } }
  .sello {
    display: inline-grid; grid-template-columns: auto auto; align-items: center; column-gap: 10px; justify-items: start;
    padding: 8px 16px; min-height: 44px; white-space: nowrap; text-decoration: none; color: var(--sobre-color);
    border: 3px solid var(--linea); border-radius: 14px; box-shadow: 4px 4px 0 var(--sombra);
    transform: rotate(var(--giro));
  }
  .sello strong { font-size: 20px; font-weight: 800; line-height: 1.2; }
  .sello span { font-family: var(--mono); font-size: 12px; font-weight: 600; }
  .sello:hover { transform: rotate(0) scale(1.05); }
  /* El logo, como una pegatina redonda pegada a la pegatina. */
  .sello__logo {
    grid-row: span 2; width: 34px; height: 34px; padding: 3px; border-radius: 50%;
    background: #fff; border: 2px solid var(--linea); object-fit: contain;
    transition: transform .3s var(--rebote);
  }
  .sello .sello__logo--icono { display: grid; place-items: center; font-family: inherit; font-size: 18px; line-height: 1; }
  .sello:hover .sello__logo { transform: rotate(-12deg) scale(1.1); }
  .sello strong + span { grid-column: 2; }

  @media (prefers-reduced-motion: reduce) {
    .cinta { overflow: visible; }
    .cinta__pista { animation: none; flex-wrap: wrap; flex-shrink: 1; padding: 0 16px; row-gap: 16px; }
    .cinta__pista--copia, .repetida { display: none; }
  }
</style>
