# Calendarios con su tipo, para que Google Calendar y el móvil los reconozcan.
AddType text/calendar .ics
AddCharset utf-8 .ics .json

ErrorDocument 404 /404.html

# Una sola dirección para Google: todothon.volmer.es y www.todothon.es → todothon.es (301).
# /api/ se queda donde está: la Action diaria llama a api/traer.php por todothon.volmer.es.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/api/
  # Ni las páginas de error internas (un 404 de /api/ pasa por /404.html y no debe acabar en 301).
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTP_HOST} ^(todothon\.volmer\.es|www\.todothon\.es)$ [NC]
  RewriteRule ^(.*)$ https://todothon.es/$1 [R=301,L]
</IfModule>

# Caché larga para lo que Astro genera con hash en el nombre.
<IfModule mod_headers.c>
  <FilesMatch "^.*\.[0-9A-Za-z_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
